{
  "name": "grafana-weathermap",
  "private": true,
  "version": "0.2.1",
  "scripts": {
    "build": "rspack -c ./rspack.config.ts --env production",
    "dev": "rspack -w -c ./rspack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "author": "Kasumi Hanazuki",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@grafana/plugin-e2e": "^3.15.4",
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.65.0",
    "@rspack/cli": "^2.2.0",
    "@rspack/core": "^2.2.0",
    "@swc/core": "^1.15.32",
    "@swc/helpers": "^0.5.24",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^10.14.0",
    "identity-obj-proxy": "^3.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "rspack-merge": "^1.0.1",
    "rspack-plugin-virtual-module": "^1.0.0",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "semver": "^7.7.4",
    "ts-checker-rspack-plugin": "^1.7.0",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2",
    "webpack": "^5.106.2",
    "ws": "^8.13.0"
  },
  "engines": {
    "node": ">=22.23"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "^13.3.0",
    "@grafana/i18n": "^13.3.0",
    "@grafana/runtime": "^13.3.0",
    "@grafana/schema": "^13.3.0",
    "@grafana/ui": "^13.3.0",
    "@xyflow/react": "^12.10.2",
    "d3": "7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.18.0"
}
